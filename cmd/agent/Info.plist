<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded in macOS builds by `make macos` (__TEXT,__info_plist), so the agent
  binary can hold the Local Network permission itself. macOS keys the grant on
  CFBundleIdentifier: changing it means approving the alert again.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.tikimcfee.gomuxai</string>
	<key>CFBundleName</key>
	<string>gomuxai</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>The agent bus links this Mac to the other machines you paired it with, so agents on them can reach each other.</string>
</dict>
</plist>
